name: nextcloud-aio
services:
  nextcloud-aio-mastercontainer:
    image: ghcr.io/nextcloud-releases/all-in-one:latest
    init: true
    restart: always
    container_name: nextcloud-aio-mastercontainer
    volumes:
      - nextcloud_aio_mastercontainer:/mnt/docker-aio-config
      - {{ docker_socket_path }}:/var/run/docker.sock:ro
    networks:
      - nextcloud-aio
    ports:
      - "8080:8080"
    environment:
      APACHE_PORT: 11000
      APACHE_IP_BINDING: 0.0.0.0
      SKIP_DOMAIN_VALIDATION: true
      WATCHTOWER_DOCKER_SOCKET_PATH: {{ docker_socket_path }}

  caddy:
    image: caddy:alpine
    restart: always
    container_name: caddy
    volumes:
      - {{ nextcloud_aio_compose_path }}/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_config:/config
      - caddy_data:/data
    networks:
      - nextcloud-aio
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"

volumes:
  nextcloud_aio_mastercontainer:
    name: nextcloud_aio_mastercontainer
  caddy_config:
    name: caddy_config
  caddy_data:
    name: caddy_data

networks:
  nextcloud-aio:
    name: nextcloud-aio

[Unit]
Description=Podman Compose - Nextcloud AIO
Documentation=man:podman-generate-systemd(1)
Wants=podman.socket
After=podman.socket
Requires=podman.socket

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ nextcloud_aio_compose_path }}
Environment=PODMAN_SOCK={{ podman_socket_path }}
ExecStart=/usr/bin/podman-compose up -d
ExecStop=/usr/bin/podman-compose down
TimeoutStartSec=0

[Install]
WantedBy=default.target

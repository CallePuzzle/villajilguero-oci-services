[Unit]
Description=Docker Compose - Caddy reverse proxy
Documentation=https://docs.docker.com/engine/security/rootless/
Wants=docker.service
After=docker.service
ConditionPathExists=/run/user/%U/docker.sock

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ caddy_compose_path }}
Environment=DOCKER_HOST=unix://{{ docker_host_socket_path }}
Environment=PATH=/usr/bin:/bin:/usr/local/bin
ExecStartPre=/bin/sh -c 'until [ -S {{ docker_host_socket_path }} ]; do sleep 1; done'
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0

[Install]
WantedBy=default.target
